# Archived material kept on disk, but not part of the Daygo repository.
/legacy/

# Local databases and SQLite sidecars
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.db
*.db-shm
*.db-wal
*.db-journal

# Packaged applications and archives
*.app/
*.dmg
*.pkg
*.zip
*.tar.gz
*.xcarchive/
*.dSYM/

# Only anonymous database/archive fixtures are exempt; later rules still apply.
!**/testdata/**/*.sqlite
!**/testdata/**/*.sqlite3
!**/testdata/**/*.db
!**/testdata/**/*.zip
!**/testdata/**/*.tar.gz

# Go build and test artifacts
/bin/
/daygo
/Daygo
/daygo.exe
/Daygo.exe
*.test
*.test.exe
*.prof
*.coverprofile
coverage.out
coverage/
go.work
go.work.sum

# Frontend dependencies, caches and generated bindings
node_modules/
.npm/
.vite/
dist/
/frontend/wailsjs/
/frontend/package.json.md5
*.tsbuildinfo
npm-debug.log*

# Wails resources under build/ are source inputs, not disposable output.
/build/bin/
/build/native/
/build/deps/
/build/diagnostics/
/build/windows/installer/
build_tmp/
build_universal/

# Browser test artifacts
.playwright-mcp/
playwright-report/
test-results/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Local recordings, caches, backups and runtime files
recordings/
timelapses/
backups/
.cache/
.tmp/
tmp/
temp/
*.sock
*.log
*.tmp

# macOS and Windows metadata
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Editors and local agent settings
.idea/
.vscode/
*.swp
*.swo
*~
.claude/
.agents/

# Secrets stay ignored inside testdata; only explicit environment examples are exempt.
.env
.env.*
!.env.example
!.env.*.example
*.local
*.secret
*.secrets
*.pem
*.key
*.p12
*.pfx
*.password
*.keychain
*.keychain-db
.daygo-signing/
